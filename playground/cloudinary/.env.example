CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nuxt-studio-playground

# Required by the configured repository/auth provider when using Studio in production.
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_MODERATORS=

# AI provider — fill the one matching studio.ai.provider in nuxt.config:
# Groq (provider: 'groq' — free tier via GroqCloud, works in all regions):
GROQ_API_KEY=
# Vercel AI Gateway (provider: 'gateway'):
NUXT_STUDIO_AI_API_KEY=
# Google Gemini (provider: 'gemini'):
GEMINI_API_KEY=
NUXT_STUDIO_AI_GEMINI_API_KEY=
