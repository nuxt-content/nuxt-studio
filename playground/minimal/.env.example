# Copy this file to .env and fill in your values

# If using GitHub OAuth
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_MODERATORS=

# AI features (optional)
# Groq (free tier via GroqCloud):
GROQ_API_KEY=
# Vercel AI Gateway:
NUXT_STUDIO_AI_API_KEY=
# Google Gemini:
GEMINI_API_KEY=
NUXT_STUDIO_AI_GEMINI_API_KEY=

# External media storage - Cloudinary (optional, requires studio.media.external: true, provider: 'cloudinary')
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=studio
