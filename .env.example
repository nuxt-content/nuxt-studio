# Cloudinary external media provider (when studio.media.provider is "cloudinary")
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=studio

# AI provider — set one of the following depending on studio.ai.provider:
# - GROQ_API_KEY for Groq (free tier via GroqCloud, works in all regions)
# - NUXT_STUDIO_AI_API_KEY for Vercel AI Gateway
# - GEMINI_API_KEY for Google Gemini (region-limited free tier)
GROQ_API_KEY=
NUXT_STUDIO_AI_API_KEY=
GEMINI_API_KEY=
NUXT_STUDIO_AI_GEMINI_API_KEY=

# If using GitHub provider
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_MODERATORS=

# If using GitLab provider
STUDIO_GITLAB_APPLICATION_ID=
STUDIO_GITLAB_APPLICATION_SECRET=
STUDIO_GITLAB_MODERATORS=

STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
STUDIO_GOOGLE_MODERATORS=user@domain.com,user2@domain.com
# If using GitHub provider with Google Oauth
STUDIO_GITHUB_TOKEN=

# If using GitLab provider with Google Oauth
STUDIO_GITLAB_TOKEN=

# If using SSO server (https://github.com/nuxt-content/nuxt-studio-sso)
STUDIO_SSO_URL=
STUDIO_SSO_CLIENT_ID=
STUDIO_SSO_CLIENT_SECRET=
